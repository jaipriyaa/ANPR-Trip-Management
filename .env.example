# Database Connection URL (Docker & Local)
DATABASE_URL=postgresql://postgres:1234@postgres:5432/anpr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=anpr_db
POSTGRES_PORT=5432

# Redis Cache URL
REDIS_URL=redis://redis:6379/0

# Inference Backend Configuration: AUTO, TENSORRT, ONNX, PYTORCH
MODEL_BACKEND=AUTO

# GPU Hardware Configuration (Set true if NVIDIA Container Toolkit installed)
GPU_ENABLED=true
GPU_DEVICE=0

# Model Paths & Directories
TENSORRT_ENGINE_PATH=models/
ONNX_MODEL_PATH=models/
VEHICLE_MODEL_PATH=backend/yolo11n.pt
PLATE_MODEL_PATH=backend/app/ai/weights/plate_detector.pt
UPLOAD_DIR=uploads/

# Application Security
SECRET_KEY=super-secret-jwt-key-for-industrial-anpr-trip-management
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
